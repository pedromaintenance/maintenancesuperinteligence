{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Custodian-owned pre-distribution coverage policy",
  "required": [
    "schema",
    "version",
    "splitMinimums",
    "requiredTestDomains",
    "requiredTestStatuses",
    "requiredTestMechanisms",
    "nearDuplicateThreshold",
    "independentExpertEndorsed"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.private-quality-policy.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "splitMinimums": {
      "type": "object",
      "required": [
        "train",
        "dev",
        "test"
      ],
      "additionalProperties": false,
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 1
        },
        "dev": {
          "type": "integer",
          "minimum": 1
        },
        "test": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "requiredTestDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mechanics",
          "hydraulics",
          "electronics",
          "cooling",
          "unsupported"
        ]
      }
    },
    "requiredTestStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "unverified",
          "conflicting",
          "stale",
          "revoked",
          "synthetic_complete"
        ]
      }
    },
    "requiredTestMechanisms": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        }
      }
    },
    "nearDuplicateThreshold": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 0.95
    },
    "independentExpertEndorsed": {
      "const": false
    }
  }
}
