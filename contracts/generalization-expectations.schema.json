{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Cycle 28 editorial expectations for new cases",
  "required": [
    "schema",
    "version",
    "nature",
    "diagnosticAccuracyMeasured",
    "independentExpertValidation",
    "expectations"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.generalization-expectations.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "nature": {
      "const": "author_defined_unseen_by_cycle27_not_independently_reviewed"
    },
    "diagnosticAccuracyMeasured": {
      "const": false
    },
    "independentExpertValidation": {
      "const": false
    },
    "expectations": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "expectedNextQuestionId",
          "expectedAbstention",
          "expectedOperationalAuthority"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^SIM-GEN-[0-9]{3}$"
          },
          "expectedNextQuestionId": {
            "type": "string"
          },
          "expectedAbstention": {
            "const": true
          },
          "expectedOperationalAuthority": {
            "const": false
          }
        }
      }
    }
  }
}
