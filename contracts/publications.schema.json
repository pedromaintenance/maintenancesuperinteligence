{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/publications.schema.json",
  "title": "Offline Pages provenance audit — NOT independent engineering validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "frozenAt",
    "evidenceNature",
    "canonicalSource",
    "baselineCatalog",
    "siteBase",
    "releases",
    "currentViewer",
    "restrictedEvidenceIncluded",
    "externalStudyGatesVerified",
    "operationallyApproved",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.publication-history.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "frozenAt": {
      "const": "2026-11-05"
    },
    "evidenceNature": {
      "const": "github_actions_success_and_repository_blobs_not_live_http_or_human_approval"
    },
    "canonicalSource": {
      "const": "interfaces/catalog.v1.json"
    },
    "baselineCatalog": {
      "const": "interfaces/snapshots/c51-pages-deploy.v1.json"
    },
    "siteBase": {
      "const": "https://pedromaintenance.github.io/maintenancesuperinteligence/"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "cycle",
          "publicationDateUtc",
          "sourceBranch",
          "sourceCommit",
          "deploymentWorkflow",
          "workflowRunId",
          "workflowRunUrl",
          "evidenceStatus",
          "pagesEnvironmentUrl",
          "siteHttpIndependentlyVerified",
          "qualifiedHumanReviewCompleted",
          "operationalAuthorityGranted",
          "files",
          "notes"
        ],
        "properties": {
          "id": {
            "const": "PAGES-2026-11-05-001"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "cycle": {
            "const": 51
          },
          "publicationDateUtc": {
            "const": "2026-11-05T15:11:13Z"
          },
          "sourceBranch": {
            "const": "main"
          },
          "sourceCommit": {
            "const": "ad9a9b3e321dfe696a8a816e5cdc17637f9f0afc"
          },
          "deploymentWorkflow": {
            "const": "Publish Maintenance Superintelligence portals to GitHub Pages"
          },
          "workflowRunId": {
            "const": 42052320131
          },
          "workflowRunUrl": {
            "const": "https://github.com/pedromaintenance/maintenancesuperinteligence/actions/runs/42052320131"
          },
          "evidenceStatus": {
            "const": "github_actions_reported_success"
          },
          "pagesEnvironmentUrl": {
            "const": "https://pedromaintenance.github.io/maintenancesuperinteligence/"
          },
          "siteHttpIndependentlyVerified": {
            "const": false
          },
          "qualifiedHumanReviewCompleted": {
            "const": false
          },
          "operationalAuthorityGranted": {
            "const": false
          },
          "files": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "gitBlobSha",
                "nature"
              ],
              "properties": {
                "path": {
                  "enum": [
                    "index.html",
                    "auditoria.html"
                  ]
                },
                "gitBlobSha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "nature": {
                  "const": "standalone_public_html"
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "currentViewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "claim",
        "approvedForOperations",
        "independentEngineeringValidation"
      ],
      "properties": {
        "label": {
          "const": "Visualização da branch em análise"
        },
        "claim": {
          "const": "embedded_catalog_as_rendered_not_a_live_github_snapshot"
        },
        "approvedForOperations": {
          "const": false
        },
        "independentEngineeringValidation": {
          "const": false
        }
      }
    },
    "restrictedEvidenceIncluded": {
      "const": false
    },
    "externalStudyGatesVerified": {
      "const": 0
    },
    "operationallyApproved": {
      "const": false
    },
    "decision": {
      "const": "NO GO"
    }
  }
}
