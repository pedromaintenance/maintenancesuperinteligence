{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "observationId",
    "testResultId",
    "hypothesisId",
    "relation",
    "nature",
    "sourceRef",
    "limitations"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "pattern": "^EVD-[0-9]{3}$"
    },
    "observationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "testResultId": {
      "type": [
        "string",
        "null"
      ]
    },
    "hypothesisId": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation": {
      "enum": [
        "consistent_with",
        "inconsistent_with",
        "not_discriminating"
      ]
    },
    "nature": {
      "const": "didactic_inference"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^SIM-[A-Za-z0-9_-]+$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/evidence.schema.json"
}
