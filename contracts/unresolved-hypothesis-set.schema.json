{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/unresolved-hypothesis-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesisIds",
    "allOpen",
    "hypothesesExcluded",
    "rootCauseConfirmed"
  ],
  "properties": {
    "hypothesisIds": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOpen": {
      "const": true
    },
    "hypothesesExcluded": {
      "const": 0
    },
    "rootCauseConfirmed": {
      "const": false
    }
  }
}
