{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/editorial-evidence-gap-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "oemEffectivitySourceAuthenticated",
    "physicalEvidenceCollected",
    "contextChangesRequireReReview",
    "allCurrentReviewGatesSatisfied"
  ],
  "properties": {
    "oemEffectivitySourceAuthenticated": {
      "const": false
    },
    "physicalEvidenceCollected": {
      "const": false
    },
    "contextChangesRequireReReview": {
      "const": true
    },
    "allCurrentReviewGatesSatisfied": {
      "const": false
    }
  }
}
