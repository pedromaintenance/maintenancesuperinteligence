{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/editorial-document-revision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "trigger",
    "reason",
    "revisionDigest",
    "realDocumentEdited"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "trigger": {
      "enum": [
        "submit",
        "revise",
        "reopen_context"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "revisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "realDocumentEdited": {
      "const": false
    }
  }
}
