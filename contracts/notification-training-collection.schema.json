{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/notification-training-collection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "mode",
    "specSha256",
    "sourceTreesSha256",
    "drafts",
    "draftCount",
    "allHypothesesRemainOpen",
    "realNotificationsCreated",
    "workOrdersCreated",
    "physicalTestsExecuted",
    "mayConnectToSap",
    "mayReleaseEquipment"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.notification-training-collection.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "const": "public_synthetic_training_only"
    },
    "specSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceTreesSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "drafts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "notification-draft.schema.json"
      }
    },
    "draftCount": {
      "const": 4
    },
    "allHypothesesRemainOpen": {
      "const": true
    },
    "realNotificationsCreated": {
      "const": 0
    },
    "workOrdersCreated": {
      "const": 0
    },
    "physicalTestsExecuted": {
      "const": 0
    },
    "mayConnectToSap": {
      "const": false
    },
    "mayReleaseEquipment": {
      "const": false
    }
  }
}
