{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/control-evidence.schema.json",
  "title": "ControlEvidence synthetic placeholder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "controlId",
    "nature",
    "reference",
    "provenanceAuthenticated",
    "identityVerified",
    "accessRightVerified",
    "sourceDigest",
    "verifiedByIndependentPerson",
    "containsPrivateData",
    "containsLicensedMaterial"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "pattern": "^SIM-EVIDENCE-[0-9]{2}$"
    },
    "controlId": {
      "type": "string",
      "minLength": 1
    },
    "nature": {
      "const": "synthetic_placeholder_only"
    },
    "reference": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^SIM-PLAN-[0-9]{2}$"
        }
      ]
    },
    "provenanceAuthenticated": {
      "const": false
    },
    "identityVerified": {
      "const": false
    },
    "accessRightVerified": {
      "const": false
    },
    "sourceDigest": {
      "type": "null"
    },
    "verifiedByIndependentPerson": {
      "const": false
    },
    "containsPrivateData": {
      "const": false
    },
    "containsLicensedMaterial": {
      "const": false
    }
  }
}
