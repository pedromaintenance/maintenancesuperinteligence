{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/dependency-path-explanation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetControlId",
    "rootControlId",
    "rootReason",
    "selectedPath",
    "stepCount",
    "explanationSteps",
    "alternativePathCount",
    "alternativePathWitness",
    "evidenceActuallyVerified",
    "physicalFaultConfirmed",
    "mayAuthorizeMaintenance"
  ],
  "properties": {
    "targetControlId": {
      "type": "string",
      "minLength": 1
    },
    "rootControlId": {
      "type": "string",
      "minLength": 1
    },
    "rootReason": {
      "type": "string",
      "minLength": 1
    },
    "selectedPath": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stepCount": {
      "type": "integer",
      "minimum": 0
    },
    "explanationSteps": {
      "type": "array",
      "items": {
        "$ref": "dependency-path-step.schema.json"
      }
    },
    "alternativePathCount": {
      "type": "integer",
      "minimum": 0
    },
    "alternativePathWitness": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "evidenceActuallyVerified": {
      "const": false
    },
    "physicalFaultConfirmed": {
      "const": false
    },
    "mayAuthorizeMaintenance": {
      "const": false
    }
  }
}
