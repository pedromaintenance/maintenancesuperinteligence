{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/readiness-change-scenario.schema.json",
  "title": "Synthetic change invalidation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioId",
    "eventType",
    "invalidates",
    "sourceEvidenceRef",
    "state",
    "reopenReview",
    "previousQualificationRemainsValid",
    "automaticReapproval",
    "operationalPermission"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "pattern": "^SIM-SCENARIO-[0-9]{2}$"
    },
    "eventType": {
      "enum": [
        "identity_revoked",
        "oem_publication_revision_changed",
        "equipment_configuration_changed",
        "claim_revision_changed",
        "qualification_changed",
        "conflict_of_interest_discovered"
      ]
    },
    "invalidates": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceEvidenceRef": {
      "type": "null"
    },
    "state": {
      "const": "simulated_not_occurred"
    },
    "reopenReview": {
      "const": true
    },
    "previousQualificationRemainsValid": {
      "const": false
    },
    "automaticReapproval": {
      "const": false
    },
    "operationalPermission": {
      "const": false
    }
  }
}
