{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchorId",
    "claimId",
    "sourceDigest",
    "externalTimestampVerified",
    "externalStoreVerified",
    "appendOnlyVerified",
    "signerVerified"
  ],
  "properties": {
    "anchorId": {
      "type": "string"
    },
    "claimId": {
      "type": "string"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "externalTimestampVerified": {
      "const": false
    },
    "externalStoreVerified": {
      "const": false
    },
    "appendOnlyVerified": {
      "const": false
    },
    "signerVerified": {
      "const": false
    }
  }
}
