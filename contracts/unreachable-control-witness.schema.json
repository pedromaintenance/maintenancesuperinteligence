{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/unreachable-control-witness.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetControlId",
    "testedRootControlIds",
    "reason",
    "noPathWitness",
    "physicalSafetyEstablished",
    "maySkipExternalReview"
  ],
  "properties": {
    "targetControlId": {
      "type": "string",
      "minLength": 1
    },
    "testedRootControlIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "const": "no_directed_documentary_dependency_path"
    },
    "noPathWitness": {
      "const": "independent_floyd_warshall_and_dfs_agree"
    },
    "physicalSafetyEstablished": {
      "const": false
    },
    "maySkipExternalReview": {
      "const": false
    }
  }
}
