{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/cycle45-review-receipt.schema.json",
  "title": "Private submission freeze receipt",
  "description": "Hash detects change, never a digital human signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "packetDigest",
    "submissionDigest",
    "reviewerAlias",
    "frozen",
    "authenticatesHumanIdentity"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.cycle45-review-receipt.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "packetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "submissionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewerAlias": {
      "type": "string",
      "pattern": "^REV-[A-Z0-9]{2,16}$"
    },
    "frozen": {
      "const": true
    },
    "authenticatesHumanIdentity": {
      "const": false
    }
  }
}
