{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/cycle45-candidate-source.schema.json",
  "title": "Private study candidates, never committed",
  "description": "Custody-only; no real reviews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "mode",
    "cases",
    "realExpertReviewCompleted",
    "mayExecuteTest"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.cycle45-candidate-source.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "const": "private_custodian_pair_source"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "baseline",
          "experimental"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^HLD-[0-9]{3}$"
          },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "questionText",
              "physicalTestAuthorized"
            ],
            "properties": {
              "questionId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "questionText": {
                "type": "string",
                "minLength": 25,
                "maxLength": 500
              },
              "physicalTestAuthorized": {
                "const": false
              }
            }
          },
          "experimental": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "questionText",
              "physicalTestAuthorized"
            ],
            "properties": {
              "questionId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "questionText": {
                "type": "string",
                "minLength": 25,
                "maxLength": 500
              },
              "physicalTestAuthorized": {
                "const": false
              }
            }
          }
        }
      }
    },
    "realExpertReviewCompleted": {
      "const": false
    },
    "mayExecuteTest": {
      "const": false
    }
  }
}
