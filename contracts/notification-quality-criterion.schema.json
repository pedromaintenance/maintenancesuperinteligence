{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/notification-quality-criterion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criterionId",
    "title",
    "severity",
    "remediation",
    "checks"
  ],
  "properties": {
    "criterionId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "critical",
        "major"
      ]
    },
    "remediation": {
      "type": "string",
      "minLength": 40
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
