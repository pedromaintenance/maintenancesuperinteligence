{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/qualitative-evidence-pair.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pairId",
    "familyId",
    "firstHypothesisId",
    "secondHypothesisId",
    "requiredContextKeys",
    "methodIds",
    "sourceIds",
    "conditionalObservations",
    "alternativeExplanations",
    "interpretationStatus",
    "testStatus",
    "observedOutcome",
    "mayExcludeEitherHypothesis",
    "canAuthorizeTest"
  ],
  "properties": {
    "pairId": {
      "type": "string",
      "minLength": 1
    },
    "familyId": {
      "enum": [
        "final_drive",
        "hydraulics",
        "electronics"
      ]
    },
    "firstHypothesisId": {
      "type": "string",
      "minLength": 1
    },
    "secondHypothesisId": {
      "type": "string",
      "minLength": 1
    },
    "requiredContextKeys": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "methodIds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditionalObservations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "alternativeExplanations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "interpretationStatus": {
      "const": "unvalidated_editorial_conditionals"
    },
    "testStatus": {
      "const": "not_performed"
    },
    "observedOutcome": {
      "type": "null"
    },
    "mayExcludeEitherHypothesis": {
      "const": false
    },
    "canAuthorizeTest": {
      "const": false
    }
  }
}
