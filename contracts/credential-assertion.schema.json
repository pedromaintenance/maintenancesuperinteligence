{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/credential-assertion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principalId",
    "issuer",
    "audience",
    "issuedAt",
    "expiresAt",
    "nonce",
    "issuerVerified",
    "audienceVerified",
    "signatureVerified",
    "expiryVerified",
    "revocationChecked"
  ],
  "properties": {
    "principalId": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "null"
    },
    "audience": {
      "type": "null"
    },
    "issuedAt": {
      "type": "null"
    },
    "expiresAt": {
      "type": "null"
    },
    "nonce": {
      "type": "null"
    },
    "issuerVerified": {
      "const": false
    },
    "audienceVerified": {
      "const": false
    },
    "signatureVerified": {
      "const": false
    },
    "expiryVerified": {
      "const": false
    },
    "revocationChecked": {
      "const": false
    }
  }
}
