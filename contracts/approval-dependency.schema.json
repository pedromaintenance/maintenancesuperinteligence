{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/approval-dependency.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controlId",
    "predecessors",
    "allPrerequisitesVerified",
    "permissionToProceed"
  ],
  "properties": {
    "controlId": {
      "type": "string",
      "minLength": 1
    },
    "predecessors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allPrerequisitesVerified": {
      "const": false
    },
    "permissionToProceed": {
      "const": false
    }
  }
}
