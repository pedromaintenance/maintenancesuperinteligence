{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/dependency-graph-change-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposalId",
    "changeType",
    "sourceId",
    "targetId",
    "controlId",
    "newOwner",
    "rationale",
    "intent",
    "sourceAuthenticated",
    "technicalCompetenceVerified",
    "mayModifyCanonicalFixture",
    "mayMerge"
  ],
  "properties": {
    "proposalId": {
      "type": "string",
      "pattern": "^SIM-GDIFF-[0-9]{2}$"
    },
    "changeType": {
      "enum": [
        "edge_add",
        "edge_remove",
        "edge_reverse",
        "owner_change",
        "control_remove"
      ]
    },
    "sourceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetId": {
      "type": [
        "string",
        "null"
      ]
    },
    "controlId": {
      "type": [
        "string",
        "null"
      ]
    },
    "newOwner": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "const": "unapproved_editorial_proposal_only"
    },
    "sourceAuthenticated": {
      "const": false
    },
    "technicalCompetenceVerified": {
      "const": false
    },
    "mayModifyCanonicalFixture": {
      "const": false
    },
    "mayMerge": {
      "const": false
    }
  }
}
