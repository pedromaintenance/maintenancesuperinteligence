{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/reopen-coverage-case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "caseKind",
    "syntheticTrigger",
    "rootControlIds",
    "affectedControlIds",
    "unaffectedControlIds",
    "pathExplanations",
    "unreachableControlWitnesses",
    "affectedCount",
    "unaffectedCount",
    "coveredControlCount",
    "redundantTargetCount",
    "allPathsDocumentary",
    "realFaultDetected",
    "pilotApprovalGranted",
    "decision"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^SIM-RPATH-[0-9]{3}$"
    },
    "caseKind": {
      "enum": [
        "single_root",
        "root_pair",
        "version_identity_trigger",
        "conflict_pair"
      ]
    },
    "syntheticTrigger": {
      "type": "string",
      "minLength": 1
    },
    "rootControlIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "affectedControlIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unaffectedControlIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pathExplanations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "dependency-path-explanation.schema.json"
      }
    },
    "unreachableControlWitnesses": {
      "type": "array",
      "items": {
        "$ref": "unreachable-control-witness.schema.json"
      }
    },
    "affectedCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 13
    },
    "unaffectedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "coveredControlCount": {
      "const": 13
    },
    "redundantTargetCount": {
      "type": "integer",
      "minimum": 0
    },
    "allPathsDocumentary": {
      "const": true
    },
    "realFaultDetected": {
      "const": false
    },
    "pilotApprovalGranted": {
      "const": false
    },
    "decision": {
      "const": "no_go"
    }
  }
}
