{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/test-selection-rationale.schema.json",
  "title": "Didactic selection rationale v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule",
    "tieBreak",
    "noInformationGainOrCostScores",
    "selectedPairId",
    "selectedMethodId",
    "selectedNextQuestion",
    "selectionStatus",
    "reason"
  ],
  "properties": {
    "rule": {
      "const": "contradiction_then_unknown_then_not_applicable_then_review"
    },
    "tieBreak": {
      "const": "editorial_pair_order_then_method_order"
    },
    "noInformationGainOrCostScores": {
      "const": true
    },
    "selectedPairId": {
      "type": "string",
      "minLength": 1
    },
    "selectedMethodId": {
      "type": "string",
      "minLength": 1
    },
    "selectedNextQuestion": {
      "type": "string",
      "minLength": 1
    },
    "selectionStatus": {
      "enum": [
        "reconcile_contradiction",
        "ask_missing_context",
        "review_applicability",
        "prepare_human_method_review"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
