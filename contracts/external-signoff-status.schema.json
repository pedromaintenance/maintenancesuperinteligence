{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/external-signoff-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "signoff",
    "qualifiedSignatoryVerified",
    "externalApprovalProof",
    "canApproveOperations"
  ],
  "properties": {
    "owner": {
      "enum": [
        "IT",
        "InformationSecurity",
        "Engineering",
        "Legal",
        "MaintenanceManagement"
      ]
    },
    "signoff": {
      "const": "not_requested"
    },
    "qualifiedSignatoryVerified": {
      "const": false
    },
    "externalApprovalProof": {
      "type": "null"
    },
    "canApproveOperations": {
      "const": false
    }
  }
}
