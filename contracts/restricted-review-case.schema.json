{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/restricted-review-case.schema.json",
  "title": "Offline review sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "claimId",
    "revision",
    "events"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^SIM-RESTRICTED-[A-Z0-9-]+$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^CLM-[A-Z-]+$"
    },
    "revision": {
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "restricted-review-event.schema.json"
      }
    }
  }
}
