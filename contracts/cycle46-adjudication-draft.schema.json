{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/cycle46-adjudication-draft.schema.json",
  "title": "Cycle 46 private unresolved actions, never engineer signoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "handoffDigest",
    "adjudicatorAlias",
    "independentIdentityVerified",
    "externalEngineeringOpinionReceived",
    "entries",
    "technicalDecisionApproved",
    "mayReleaseEquipment"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.cycle46-adjudication-draft.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "handoffDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adjudicatorAlias": {
      "type": "string",
      "pattern": "^REV-[A-Z0-9]{2,16}$"
    },
    "independentIdentityVerified": {
      "const": false
    },
    "externalEngineeringOpinionReceived": {
      "const": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "proposedNextAction",
          "rationale",
          "signedByQualifiedEngineer",
          "contradictionResolved"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^HLD-[0-9]{3}$"
          },
          "proposedNextAction": {
            "enum": [
              "request_reblinding",
              "request_independent_safety_review",
              "request_independent_disagreement_review",
              "request_additional_documentary_evidence"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1200
          },
          "signedByQualifiedEngineer": {
            "const": false
          },
          "contradictionResolved": {
            "const": false
          }
        }
      },
      "minItems": 0,
      "maxItems": 50
    },
    "technicalDecisionApproved": {
      "const": false
    },
    "mayReleaseEquipment": {
      "const": false
    }
  }
}
