{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/restricted-review-event.schema.json",
  "title": "Offline synthetic review command (not signed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "claimId",
    "actorId",
    "action",
    "nonce",
    "targetRevision",
    "sourceRefs",
    "explanation",
    "signature"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^SIM-EVENT-[A-Z0-9-]+$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^CLM-[A-Z-]+$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^SIM-ACTOR-[A-Z0-9-]+$"
    },
    "action": {
      "enum": [
        "submit",
        "support_general",
        "insufficient",
        "challenge",
        "adjudicate_needs_evidence"
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^SIM-NONCE-[A-Z0-9-]+$"
    },
    "targetRevision": {
      "const": 1
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CIT-[A-Z0-9-]+$"
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1200
    },
    "signature": {
      "type": "null"
    }
  }
}
