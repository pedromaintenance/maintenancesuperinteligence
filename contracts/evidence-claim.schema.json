{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/evidence-claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimNature",
    "reportedSymptomIsMeasurement",
    "mechanismVerified",
    "rootCauseVerified",
    "observedSupportOrWeakening",
    "bothHypothesesRemainOpen"
  ],
  "properties": {
    "claimNature": {
      "const": "editorial_conditional_no_test"
    },
    "reportedSymptomIsMeasurement": {
      "const": false
    },
    "mechanismVerified": {
      "const": false
    },
    "rootCauseVerified": {
      "const": false
    },
    "observedSupportOrWeakening": {
      "type": "null"
    },
    "bothHypothesesRemainOpen": {
      "const": true
    }
  }
}
