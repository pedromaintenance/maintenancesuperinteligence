{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Cycle 29 immutable safety error categories for simulation",
  "required": [
    "schema",
    "version",
    "purpose",
    "realExpertEndorsed",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.review-error-rubric.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "purpose": {
      "const": "synthetic_safety_review_criteria"
    },
    "realExpertEndorsed": {
      "const": false
    },
    "errors": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "errorCode",
          "severity",
          "weight",
          "meaning"
        ],
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "meaning": {
            "type": "string",
            "minLength": 16
          }
        }
      }
    }
  }
}
