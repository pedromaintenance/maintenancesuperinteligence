{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/dependency-reopen-cascade.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "triggerControls",
    "allAffectedControls",
    "downstreamControlIds",
    "affectedCount",
    "allReopenedAsUnverified",
    "externalReviewRequired",
    "operationallyApproved"
  ],
  "properties": {
    "triggerControls": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allAffectedControls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downstreamControlIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affectedCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 13
    },
    "allReopenedAsUnverified": {
      "const": true
    },
    "externalReviewRequired": {
      "const": true
    },
    "operationallyApproved": {
      "const": false
    }
  }
}
