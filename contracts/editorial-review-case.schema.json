{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/editorial-review-case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "draftId",
    "caseFileId",
    "declaredDiscipline",
    "authorId",
    "reviewerIds",
    "adjudicatorId",
    "currentRevision",
    "currentRevisionDigest",
    "sourceDraftSha256",
    "documentRevisions",
    "independentRealReviewerCount",
    "fictionalCurrentReviewerCount",
    "reviewRecords",
    "adjudicationPerformedInSimulation",
    "revokedPersonaIds",
    "decision",
    "humanEditorialAgreementEstablished",
    "reviewerIdentitiesVerified",
    "reviewerCompetenceVerified",
    "auditTrail",
    "auditFinalDigest",
    "auditDigestRecomputedFromFixture",
    "externalAuditAnchorVerified",
    "evidenceGapResolution",
    "acceptanceBoundary",
    "nextHumanReviewRequirements",
    "mayBeImportedToSap",
    "mayConfirmFailure",
    "mayReleaseEquipment"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.editorial-review-case.v1"
    },
    "draftId": {
      "type": "string",
      "pattern": "^SIM-NOTE-00[1-4]$"
    },
    "caseFileId": {
      "type": "string",
      "minLength": 1
    },
    "declaredDiscipline": {
      "enum": [
        "lubrication",
        "hydraulics",
        "electronics"
      ]
    },
    "authorId": {
      "type": "string",
      "minLength": 1
    },
    "reviewerIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adjudicatorId": {
      "type": "string",
      "minLength": 1
    },
    "currentRevision": {
      "type": "integer",
      "minimum": 1
    },
    "currentRevisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceDraftSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "documentRevisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "editorial-document-revision.schema.json"
      }
    },
    "independentRealReviewerCount": {
      "const": 0
    },
    "fictionalCurrentReviewerCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "reviewRecords": {
      "type": "array",
      "items": {
        "$ref": "editorial-independent-review-decision.schema.json"
      }
    },
    "adjudicationPerformedInSimulation": {
      "type": "boolean"
    },
    "revokedPersonaIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": [
        "requires_revision",
        "unresolved_disagreement",
        "pending_real_review"
      ]
    },
    "humanEditorialAgreementEstablished": {
      "const": false
    },
    "reviewerIdentitiesVerified": {
      "const": false
    },
    "reviewerCompetenceVerified": {
      "const": false
    },
    "auditTrail": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "editorial-review-audit-event.schema.json"
      }
    },
    "auditFinalDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "auditDigestRecomputedFromFixture": {
      "const": true
    },
    "externalAuditAnchorVerified": {
      "const": false
    },
    "evidenceGapResolution": {
      "$ref": "editorial-evidence-gap-resolution.schema.json"
    },
    "acceptanceBoundary": {
      "$ref": "editorial-acceptance-boundary.schema.json"
    },
    "nextHumanReviewRequirements": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mayBeImportedToSap": {
      "const": false
    },
    "mayConfirmFailure": {
      "const": false
    },
    "mayReleaseEquipment": {
      "const": false
    }
  }
}
