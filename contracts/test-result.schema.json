{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "testResultId",
    "testMethodId",
    "nature",
    "status",
    "result",
    "sourceRef",
    "context",
    "limitations"
  ],
  "properties": {
    "testResultId": {
      "type": "string",
      "pattern": "^SIM-[A-Za-z0-9_-]+$"
    },
    "testMethodId": {
      "type": "string",
      "pattern": "^TM-[0-9]{3}$"
    },
    "nature": {
      "const": "simulation"
    },
    "status": {
      "const": "simulated_execution"
    },
    "result": {
      "enum": [
        "indicator_present",
        "indicator_absent",
        "inconclusive"
      ]
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^SIM-[A-Za-z0-9_-]+$"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/test-result.schema.json",
  "$defs": {
    "context": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Measurement context",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineCondition",
        "samplePoint",
        "observedAt",
        "meterHours",
        "instrumentId",
        "calibrationReference"
      ],
      "properties": {
        "machineCondition": {
          "type": [
            "string",
            "null"
          ]
        },
        "samplePoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "meterHours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "instrumentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibrationReference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
