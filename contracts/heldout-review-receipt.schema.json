{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "heldout-review-receipt",
  "required": [
    "schema",
    "packetDigest",
    "submissionDigest",
    "reviewerAlias",
    "frozen",
    "authenticatesHumanIdentity"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.heldout-review-receipt.v1"
    },
    "packetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "submissionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewerAlias": {
      "type": "string",
      "pattern": "^REV-[A-Z0-9]{2,16}$"
    },
    "frozen": {
      "const": true
    },
    "authenticatesHumanIdentity": {
      "const": false
    }
  }
}
