{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/maintenancesuperinteligence/contracts/exception-request.schema.json",
  "title": "ExceptionRequest — never bypass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exceptionId",
    "controlId",
    "requesterId",
    "rationale",
    "sourceRef",
    "decision",
    "waiveControl",
    "mayDeploy",
    "approvedByRealPerson"
  ],
  "properties": {
    "exceptionId": {
      "type": "string",
      "pattern": "^SIM-EXCEPTION-[0-9]{2}$"
    },
    "controlId": {
      "type": "string",
      "minLength": 1
    },
    "requesterId": {
      "type": "string",
      "pattern": "^SIM-REQUESTER-[A-Z0-9-]+$"
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300
    },
    "sourceRef": {
      "type": "null"
    },
    "decision": {
      "const": "blocked_no_verified_evidence"
    },
    "waiveControl": {
      "const": false
    },
    "mayDeploy": {
      "const": false
    },
    "approvedByRealPerson": {
      "const": false
    }
  }
}
