{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Cycle31 editorial dataset quality gates",
  "required": [
    "schema",
    "version",
    "purpose",
    "taxonomy",
    "splitMinimums",
    "unsupportedTestMinimum",
    "sourceReliabilityRequiredInTest",
    "nearDuplicateJaccardThreshold",
    "independentReviewCompleted",
    "realWorldAccuracyMeasured",
    "mayApproveOperationalUse"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.validation-quality-policy.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "purpose": {
      "const": "synthetic_split_preflight_not_field_validation"
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "final_drive",
        "hydraulics",
        "electronics",
        "cooling"
      ],
      "additionalProperties": false,
      "properties": {
        "final_drive": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "hydraulics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "electronics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "cooling": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "splitMinimums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "dev",
        "test"
      ],
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 1
        },
        "dev": {
          "type": "integer",
          "minimum": 1
        },
        "test": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "unsupportedTestMinimum": {
      "type": "integer",
      "minimum": 1
    },
    "sourceReliabilityRequiredInTest": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "contradictory",
          "revoked",
          "unverified"
        ]
      }
    },
    "nearDuplicateJaccardThreshold": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 0.95
    },
    "independentReviewCompleted": {
      "const": false
    },
    "realWorldAccuracyMeasured": {
      "const": false
    },
    "mayApproveOperationalUse": {
      "const": false
    }
  }
}
