{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author synthetic mechanical differential reasoning cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "purpose",
    "oemEffectivityVerified",
    "realFieldEvidence",
    "reviewedByIndependentMechanicalExpert",
    "operationallyApproved",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "maintenance-superinteligence.mechanical-reasoning-cases.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "purpose": {
      "const": "authored_synthetic_differential_reasoning_regression"
    },
    "oemEffectivityVerified": {
      "const": false
    },
    "realFieldEvidence": {
      "const": false
    },
    "reviewedByIndependentMechanicalExpert": {
      "const": false
    },
    "operationallyApproved": {
      "const": false
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "familyId",
        "scenarioVariant",
        "fictionalSymptom",
        "unresolvedContradiction",
        "contextAvailable",
        "observationNature",
        "confirmedRootCause",
        "mayCreateWorkOrder",
        "mayReleaseEquipment",
        "mayRunTests"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^SIM-MECH-[0-9]{3}$"
        },
        "familyId": {
          "enum": [
            "final_drive",
            "hydraulics",
            "electronics",
            "cooling"
          ]
        },
        "scenarioVariant": {
          "enum": [
            "conflict",
            "first_missing",
            "second_missing",
            "third_missing",
            "fourth_missing",
            "context_complete"
          ]
        },
        "fictionalSymptom": {
          "type": "string",
          "minLength": 1
        },
        "unresolvedContradiction": {
          "type": "boolean"
        },
        "contextAvailable": {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 4,
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "observationNature": {
          "const": "synthetic_narrative_not_measured"
        },
        "confirmedRootCause": {
          "type": "null"
        },
        "mayCreateWorkOrder": {
          "const": false
        },
        "mayReleaseEquipment": {
          "const": false
        },
        "mayRunTests": {
          "const": false
        }
      }
    }
  }
}
